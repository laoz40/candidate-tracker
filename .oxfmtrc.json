{
  "ignorePatterns": [
    "docs/**",
    "AGENTS.md",
    "README.md",
    "pnpm-lock.yaml",
    "**/routeTree.gen.ts",
    "**/dist/**",
    "tools/oxlint/anti-slop/**",
    "**/components/ui/**",
    "**/vendor/**",
    "**/generated/**",
    "**/*.gen.*",
    "**/*.generated.*",
    "**/coverage/**"
  ],
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleAttributePerLine": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "semi": true
}

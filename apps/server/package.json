{
  "name": "@candidate-tracker/server",
  "private": true,
  "type": "module",
  "imports": {
    "#app": {
      "types": "./src/app.ts",
      "development": "./src/app.ts",
      "default": "./dist/app.js"
    },
    "#env": {
      "types": "./src/env.ts",
      "development": "./src/env.ts",
      "default": "./dist/env.js"
    },
    "#db": {
      "types": "./src/db/index.ts",
      "development": "./src/db/index.ts",
      "default": "./dist/db/index.js"
    },
    "#schema": {
      "types": "./src/db/schema.ts",
      "development": "./src/db/schema.ts",
      "default": "./dist/db/schema.js"
    },
    "#candidates/*": {
      "types": "./src/features/candidates/*.ts",
      "development": "./src/features/candidates/*.ts",
      "default": "./dist/features/candidates/*.js"
    },
    "#documents/*": {
      "types": "./src/features/documents/*.ts",
      "development": "./src/features/documents/*.ts",
      "default": "./dist/features/documents/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "NODE_OPTIONS=--conditions=development drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS=--conditions=development drizzle-kit migrate",
    "db:studio": "NODE_OPTIONS=--conditions=development drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
